{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    // https://code.visualstudio.com/docs/editor/variables-reference

    "version": "0.2.0",
    "configurations": [
        {
            //"preLaunchTask": "build debug",
            "preRunCommands": [
                "command source .debug/lldbinit",
                "command source .debug/programs/compiler.lldb",
            ],
            "type": "lldb",
            "request": "launch",
            "name": "Debug Nim Compiler",
            "program": "bin/nim_temp",
            "args": ["c", "--debugger:native", "${relativeFile}"],
            "cwd": "${workspaceFolder}",
            "env": {
                "NIM_DEBUGGEE": "${fileBasenameNoExtension}",
                "NIM_DEBUGGEE_LINE": "${lineNumber}"
            }
        },
        {
            "preLaunchTask": "build debug for current file",
            "preRunCommands": [
                "command source .debug/lldbinit",
            ],
            "type": "lldb",
            "request": "launch",
            "name": "Debug",
            "program": "${relativeFileDirname}/${fileBasenameNoExtension}",
            "cwd": "${workspaceFolder}"
        },
        {
            //"preLaunchTask": "build debug",
            "preRunCommands": [
                "command source .debug/lldbinit",
            ],
            "type": "lldb",
            "request": "launch",
            "name": "Debug RST",
            "program": "bin/nim_debug",
            "args": ["rst2html", "-r", "--debugger:native", "--lib:lib", "--doccmd:skip", "${relativeFile}"],
            "cwd": "${workspaceFolder}"
        }
    ]
}
