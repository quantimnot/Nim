{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build debug for current file",
            "type": "shell",
            "command": "nim c --debugger:on ${relativeFileDirname}/${fileBasenameNoExtension}",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "build debug",
            "type": "shell",
            "command": "nimble intern_build_debug_fast",
            "problemMatcher": []
        },
        {
            "label": "run doc",
            "type": "shell",
            "command": "nim -r doc ${relativeFile}"
        }
    ]
}