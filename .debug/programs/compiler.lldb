# break when `nowCompilingDebuggeeTarget` in `debuggee.nim` is called
breakpoint set -n 'nowCompilingDebuggeeTarget' -N nowCompilingDebuggeeTarget
breakpoint command add nowCompilingDebuggeeTarget
	# prevent this breakpoint from triggering again
	breakpoint delete nowCompilingDebuggeeTarget
	# line of interest is being compiled now, so enable all breakpoints
	breakpoint enable
	# let's debug
	continue
DONE

# some commands can't be set until the process is running, so set an entry breakpoint
# and commands to run once it's hit
breakpoint set -r main.* -N main_entry
breakpoint command add main_entry
	# disable all current breakpoints until the module name and line of interest are being compiled
	breakpoint disable
	# enable the nowCompilingDebuggeeTarget breakpoint though
	breakpoint enable nowCompilingDebuggeeTarget

	# delete the main_entry breakpoint
	# continue execution; there's nothing we're interested in here
	# just needed a starting point to setup the debugging session
	breakpoint delete main_entry
	continue
DONE
