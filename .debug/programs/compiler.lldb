# break when the SIGTRAP handler in `debuggee.nim` is executed
# SIGTRAP is raised when the module name and line of interest are being compiled
breakpoint set -n 'onSigTrap' -c debugger_isCompilingDebuggeeTarget == true -N sigtrap
breakpoint command add sigtrap
	# prevent this breakpoint from triggering again
	breakpoint delete sigtrap
	# line of interest is being compiled now, so enable all breakpoints
	breakpoint enable
	# let's debug
	continue
DONE

# some commands can't be set until the process is running, so set an entry breakpoint
# and commands to run once it's hit
breakpoint set -r main.* -N main_entry
breakpoint command add main_entry
	# set SIGTRAP handling
	# just pass the signal to the process so `debuggee.onSigTrap` can catch it
	process handle -p true -s false -n false SIGTRAP

	# disable all current breakpoints until the module name and line of interest are being compiled
	breakpoint disable
	# enable the SIGTRAP breakpoint though
	breakpoint enable sigtrap

	# delete the main_entry breakpoint
	# continue execution; there's nothing we're interested in here
	# just needed a starting point to set signal handling
	breakpoint delete main_entry
	continue
DONE
